# ---- Core ----
ENVIRONMENT=development                 # development | staging | production
SECRET_KEY=change-me-in-prod-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Field-level encryption key (32-byte urlsafe base64). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Database ----
# Postgres (docker compose) — or use sqlite fallback for quick local dev:
#   sqlite+aiosqlite:///./sahayak.db
DATABASE_URL=postgresql+asyncpg://sahayak:sahayak@db:5432/sahayak

# ---- Cache / Queue ----
REDIS_URL=redis://redis:6379/0

# ---- Object storage (India-hosted: S3 ap-south-1 or MinIO) ----
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=ap-south-1
S3_BUCKET=sahayak-invoices
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- AI / Extraction ----
# Provider: mock | openai-compatible | anthropic
EXTRACTION_PROVIDER=mock
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# ---- WhatsApp (Meta Cloud API / 360dialog / AiSensy) ----
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=sahayak-verify

# ---- SMS / OTP (MSG91 / Twilio) ----
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Email (Resend / SES) ----
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@sahayakgst.in
RESEND_API_KEY=

# ---- Payments (Razorpay) ----
RAZORPAY_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- GSTN public search (optional, for legal name/status) ----
GSTN_SEARCH_ENABLED=false

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
